{
  "description": "Pair Desk: session-start summary with the handoff's next step, and the owner's new activity on every prompt, for the project linked to this repo",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/pair-desk\" hook session-start",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/pair-desk\" hook user-prompt-submit",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
