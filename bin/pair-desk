#!/bin/sh
# Pair Desk launcher for macOS, Linux and Git Bash on Windows: runs desk.py with the first
# Python 3.11+ it finds and passes the arguments, stdin and exit code through.
#
#   bin/pair-desk serve --detach          # same as: python desk.py serve --detach
#
# Order: $PAIR_DESK_PYTHON, python3, python3.14 ... python3.11, python, py -3. Each candidate is
# probed first, so an old system python3 (macOS ships 3.9) or the Windows Store python3 stub
# (prints an error, or exits silently without a terminal) is skipped. Windows without Git Bash
# uses bin/pair-desk.cmd instead. The Claude Code plugin, the Codex and opencode integrations
# and the docs all start the desk through these two files.

self=$0
if command -v cygpath >/dev/null 2>&1; then
    # Git Bash / MSYS: accept C:\... or C:/... in $0 and hand Windows Python a C:/... path
    self=$(cygpath -u "$self")
fi
root=$(CDPATH= cd -- "$(dirname -- "$self")/.." && pwd) || exit 1
desk=$root/desk.py
if command -v cygpath >/dev/null 2>&1; then
    desk=$(cygpath -m "$desk")
fi
: "${PYTHONUTF8:=1}"
export PYTHONUTF8

ok() {
    # true when "$@" is Python 3.11 or newer
    "$@" -I -S -c 'import sys; sys.exit(sys.version_info < (3, 11))' >/dev/null 2>&1 </dev/null
}

if [ -n "${PAIR_DESK_PYTHON:-}" ]; then
    exec "$PAIR_DESK_PYTHON" "$desk" "$@"
fi
for py in python3 python3.14 python3.13 python3.12 python3.11 python; do
    if command -v "$py" >/dev/null 2>&1 && ok "$py"; then
        exec "$py" "$desk" "$@"
    fi
done
if command -v py >/dev/null 2>&1 && ok py -3; then
    exec py -3 "$desk" "$@"
fi
echo "Pair Desk needs Python 3.11 or newer: none of python3, python3.14 ... python3.11, python or py -3" >&2
echo "on the PATH is one. Install it (https://www.python.org/downloads/, Homebrew, your package" >&2
echo "manager) or set PAIR_DESK_PYTHON to the interpreter to use." >&2
exit 127
